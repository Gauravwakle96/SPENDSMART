# Copy to .env.local and use your Firebase web application's public configuration.
# Leave these blank to run the local demo without a Firebase account.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Development-only: connects Auth/Firestore to local emulators under the
# hardcoded demo-spendsmart project. Production builds ignore this flag.
VITE_USE_FIREBASE_EMULATORS=false
